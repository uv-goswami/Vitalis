import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';

// https://vitejs.dev/config/
export default defineConfig({
  plugins: [react()],
  
  // 1. Tell Vite to treat .wasm files as plain assets
  assetsInclude: ['**/*.wasm'],
  
  // 2. Exclude all RunAnywhere packages from Vite's pre-bundling
  optimizeDeps: {
    exclude: [
      '@runanywhere/web',
      '@runanywhere/web-llamacpp',
      '@runanywhere/web-onnx',
    ],
  },
  
  // 3. Resolve Node.js built-in 'path'
  resolve: {
    alias: {
      path: 'path-browserify',
    },
  },
  
  // 4. Server headers required for SharedArrayBuffer + WebAssembly threading (Development)
  server: {
    headers: {
      'Cross-Origin-Opener-Policy': 'same-origin',
      'Cross-Origin-Embedder-Policy': 'require-corp',
    },
  },

  // 5. CRITICAL FIX: Headers required for Production / Offline PWA testing!
  // Without this, the model falls back to a single thread and takes 10x longer.
  preview: {
    headers: {
      'Cross-Origin-Opener-Policy': 'same-origin',
      'Cross-Origin-Embedder-Policy': 'require-corp',
    },
  },
  
  // 6. Worker configuration
  worker: {
    format: 'es',
  },
});